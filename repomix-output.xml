async function pDatVe() {
  const id = qs.get('st');
  if (!user) { toast('Hãy đăng ký tài khoản trước khi đặt vé', true); setTimeout(() => location.href = 'dang-nhap.html?next=' + encodeURIComponent('dat-ve.html?st=' + id), 900); return; }
  const [st, ms, combos] = await Promise.all([API.showtime(id), API.movies(), API.combos()]), mv = ms.find(x => x.movie_id === st.movie_id) || { movie_id: 0, title: st.title, rating: '' };
  let seats = await API.seatmap(id), sel = new Set(), hold = null;
  if (qs.get('resume')) { try { const r = await API.resume(+qs.get('resume'), user.id); hold = { id: r.booking_id, exp: new Date(r.expires_at).getTime() }; r.seat_ids.forEach(i => sel.add(i)); } catch (e) { showErr(e); } }
  const cmb = {}, comboTot = () => combos.reduce((a, c) => a + c.price * (cmb[c.combo_id] || 0), 0);
  const info = i => seats.find(x => x.seat_id === i), label = i => info(i).row_label + info(i).seat_no;
  const reload = async () => { seats = await API.seatmap(id); draw(); };
  const tick = () => { clearInterval(timer); timer = setInterval(async () => { const s = Math.max(0, Math.round((hold.exp - Date.now()) / 1000)), c = $('#cd'); if (c) c.textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); if (!s) { clearInterval(timer); hold = null; sel.clear(); toast('Hết 10 phút, ghế đã được trả lại', true); await reload(); } }, 1000); };
  function draw() {
    const rows = [...new Set(seats.map(s => s.row_label))], est = [...sel].reduce((a, i) => a + (info(i).price || 0), 0);
    app.innerHTML = `<div class="wrap"><div class="steps"><span class="${hold ? '' : 'on'}">1. Chọn ghế</span><span class="${hold ? 'on' : ''}">2. Thanh toán</span><span>3. Nhận vé</span></div><div class="book"><div class="box"><div class="screen">Màn hình</div>
    ${rows.map(r => `<div class="srow"><b>${r}</b>${seats.filter(s => s.row_label === r).map(s => `<button class="seat ${s.seat_type} ${s.status} ${sel.has(s.seat_id) ? 'sel' : ''}" data-id="${s.seat_id}" ${s.status !== 'AVAILABLE' || hold ? 'disabled' : ''} title="${label(s.seat_id)}, ${s.seat_type}${s.price ? ', ' + money(s.price) : ''}">${s.seat_no}</button>`).join('')}</div>`).join('')}
    <div class="legend"><span><i style="background:var(--s1)"></i>Thường</span><span><i style="background:var(--s2)"></i>VIP</span><span><i style="background:var(--s3)"></i>Ghế đôi</span><span><i style="background:var(--red)"></i>Đang chọn</span><span><i style="background:var(--s4)"></i>Đã có người</span></div></div>
    <aside class="box"><div class="sum">${poster(mv)}<div><h3>${mv.title}</h3><div class="muted">${fDate(st.start_time)} ${fTime(st.start_time)}<br>${st.theater_name || ''}, ${st.room_name || ''}</div></div></div>
    <p>Ghế: <b>${[...sel].map(label).join(', ') || 'chưa chọn'}</b></p><div class="tot"><span>Tạm tính</span><span id="tot">${est ? money(est + comboTot()) : '—'}</span></div><br>
    ${hold ? `<p>Đơn #${hold.id}, còn <b id="cd"></b> để thanh toán</p><h4 style="margin:.4rem 0">Bắp nước</h4>${combos.map(c => `<label style="display:flex;justify-content:space-between;gap:.5rem;margin:.3rem 0"><span>${c.name}<br><small class="muted">${c.desc}, ${money(c.price)}</small></span><input type="number" min="0" max="10" value="${cmb[c.combo_id] || 0}" data-cb="${c.combo_id}" style="width:64px;min-width:0"></label>`).join('')}<div class="pay"><input id="promo" placeholder="Mã khuyến mãi" style="min-width:0;width:100%;margin-bottom:.5rem"><label><input type="radio" name="m" value="MOMO" checked>Ví MoMo</label><label><input type="radio" name="m" value="ZALOPAY">ZaloPay</label><label><input type="radio" name="m" value="CARD">Thẻ ATM / Visa</label></div><br><button class="btn" id="pay">Thanh toán</button> <button class="btn alt" id="cancel">Huỷ đơn</button>`
      : `<button class="btn" id="hold" ${sel.size ? '' : 'disabled'}>Giữ ghế 10 phút</button><p class="muted small">Chọn tối đa 8 ghế mỗi đơn.</p>`}</aside></div></div>`;
    app.querySelectorAll('.seat').forEach(b => b.onclick = () => { const i = +b.dataset.id; if (sel.has(i)) sel.delete(i); else if (sel.size < 8) sel.add(i); else toast('Tối đa 8 ghế mỗi đơn', true); draw(); });
    app.querySelectorAll('[data-cb]').forEach(i => i.oninput = () => { cmb[i.dataset.cb] = Math.max(0, Math.min(10, +i.value || 0)); $('#tot').textContent = money(est + comboTot()); });
    on('#hold', async () => { try { const r = await API.hold(user.id, +id, [...sel]); hold = { id: r.booking_id, exp: r.expires_at ? new Date(r.expires_at).getTime() : Date.now() + 600000 }; toast('Đã giữ ghế, hãy thanh toán trong 10 phút'); draw(); tick(); } catch (e) { showErr(e); sel.clear(); await reload(); } });
    on('#pay', async () => { try { const r = await API.confirm(hold.id, $('#promo').value.trim() || null, document.querySelector('[name=m]:checked').value, cmb); clearInterval(timer); sessionStorage.setItem('ticket', JSON.stringify({ ...r, booking_id: hold.id, title: mv.title, when: fDate(st.start_time) + ' ' + fTime(st.start_time), room: (st.theater_name || '') + ', ' + st.room_name })); location.href = 've.html'; } catch (e) { showErr(e); } });
    on('#cancel', async () => { try { await API.cancel(hold.id, user.id); clearInterval(timer); hold = null; sel.clear(); toast('Đã huỷ đơn'); await reload(); } catch (e) { showErr(e); } });
  }
  draw();
  if (hold) tick();
}

