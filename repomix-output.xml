// ===== Cấu hình: 'mock' chạy độc lập trong trình duyệt, 'ords' gọi Oracle REST Data Services thật =====
const CONFIG = { MODE: 'mock', BASE: 'https://localhost:8443/ords/cinema' };
const HOLD_MS = 10 * 60 * 1000;
const raise = (code, msg) => { const e = new Error(msg); e.code = code; throw e; };

// ---------- Chế độ ORDS: gọi đúng các endpoint ở mục 3.9 của báo cáo ----------
async function ords(path, method = 'GET', body) {
  const r = await fetch(CONFIG.BASE + path, { method, headers: { 'Content-Type': 'application/json' }, body: body && JSON.stringify(body) });
  let j = {}; try { j = await r.json(); } catch (_) {}
  if (!r.ok) {
    const m = /ORA-(\d+):?\s*([^\n]*)/.exec(j.message || j.error || '');
    raise(m ? -Number(m[1]) : r.status, m ? m[2] : (j.message || 'Lỗi ' + r.status));
  }
  return j;
}
const ordsApi = {
  movies: () => ords('/movies').then(j => j.items.map(m => ({ status: 'NOW', ...m, metadata: typeof m.metadata === 'string' ? JSON.parse(m.metadata) : m.metadata }))),
  showtimes: id => ords('/showtimes?movie_id=' + id).then(j => j.items),
  seatmap: id => ords('/seatmap/' + id).then(j => j.items),
  hold: (c, s, ids) => ords('/hold', 'POST', { p_customer_id: c, p_showtime_id: s, p_seat_ids: JSON.stringify(ids) }),
  confirm: (b, p, m, c) => ords('/confirm', 'POST', { p_booking_id: b, p_promo_code: p, p_method: m, p_combos: JSON.stringify(c || {}) }),
  cancel: (b, c) => ords('/cancel', 'POST', { p_booking_id: b, p_customer_id: c }),
  register: (n, e, p) => ords('/register', 'POST', { p_full_name: n, p_email: e, p_password: p }),
  revenue: () => ords('/revenue').then(j => j.items),
  audit: () => ords('/audit').then(j => j.items).catch(() => []),
  showtime: id => Promise.resolve({ showtime_id: id, title: 'Suất #' + id, room_name: '' }),
  login: (e, p) => ords('/login', 'POST', { p_email: e, p_password: p }),
  myBookings: c => ords('/mybookings?customer_id=' + c).then(j => j.items),
  allShowtimes: () => ords('/showtimes').then(j => j.items),
  addShowtime: (m, r, t, p) => ords('/addshowtime', 'POST', { p_movie_id: m, p_room_id: r, p_start: new Date(t).toISOString(), p_base_price: p }),
  rooms: () => ords('/rooms').then(j => j.items),
  theaters: () => ords('/theaters').then(j => j.items),
  requestReset: e => ords('/forgot', 'POST', { p_email: e }),
  resetPassword: (e, o, n) => ords('/reset', 'POST', { p_email: e, p_otp: o, p_new: n }),
  resume: (b, c) => ords('/booking/' + b + '?customer_id=' + c),
  setRole: (c, r) => ords('/role', 'POST', { p_customer_id: c, p_role: r }),
  reviews: id => ords('/reviews?movie_id=' + id).then(j => j.items),
  addReview: (c, m, r, t) => ords('/reviews', 'POST', { p_customer_id: c, p_movie_id: m, p_rating: r, p_content: t }),
  combos: () => ords('/combos').then(j => j.items), saveCombo: c => ords('/combos', 'POST', c), deleteCombo: id => ords('/combos/' + id, 'DELETE'),
  promos: () => ords('/promos').then(j => j.items), savePromo: p => ords('/promos', 'POST', p), togglePromo: c => ords('/promos/' + c + '/toggle', 'POST'),
  saveMovie: m => ords('/movies', 'POST', m), deleteMovie: id => ords('/movies/' + id, 'DELETE'), cancelShowtime: id => ords('/showtimes/' + id + '/cancel', 'POST'),
  customers: () => ords('/customers').then(j => j.items),
  getProfile: c => ords('/profile?customer_id=' + c),
  updateProfile: (c, d) => ords('/profile', 'POST', { p_customer_id: c, p_full_name: d.full_name, p_phone: d.phone, p_birth_date: d.birth, p_gender: d.gender, p_address: d.address }),
