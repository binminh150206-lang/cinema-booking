async function aPromo(box) {
  const ps = await API.promos(), again = () => aPromo(box);
  box.innerHTML = `<h3>Thêm mã khuyến mãi</h3><form id="f" ${FORM}>${fld('code', 'Mã', 'required')}<label>Loại<br><select name="type"><option value="PERCENT">Giảm theo %</option><option value="FIXED">Giảm số tiền</option></select></label>${fld('value', 'Giá trị', 'type="number" min="1" required')}${fld('max', 'Giảm tối đa (đ)', 'type="number" min="0"')}${fld('min', 'Đơn tối thiểu (đ)', 'type="number" min="0" value="0"')}${fld('uses', 'Số lượt tối đa', 'type="number" min="1"')}${fld('days', 'Ngày áp dụng (MON,TUE,... để trống nếu mọi ngày)')}<button class="btn">Thêm mã</button></form>
  <h3>Danh sách mã</h3><table><tr><th>Mã</th><th>Loại</th><th>Giá trị</th><th>Tối đa</th><th>Tối thiểu</th><th>Ngày</th><th>Đã dùng</th><th>Trạng thái</th></tr>${ps.map(p => `<tr><td><b>${p.code}</b></td><td>${p.type === 'PERCENT' ? '%' : 'Số tiền'}</td><td>${p.type === 'PERCENT' ? p.value + '%' : money(p.value)}</td><td>${p.max ? money(p.max) : '—'}</td><td>${money(p.min)}</td><td>${p.days ? p.days.join(', ') : 'Mọi ngày'}</td><td>${p.used}/${p.maxUses ?? '∞'}</td><td><button class="btn alt" data-t="${p.code}">${p.active === false ? 'Đang tắt, bật lại' : 'Đang bật, tắt đi'}</button></td></tr>`).join('')}</table>`;
  $('#f').onsubmit = ev => { ev.preventDefault(); const f = new FormData(ev.target); act(() => API.savePromo({ code: f.get('code'), type: f.get('type'), value: f.get('value'), max: f.get('max'), min: f.get('min'), maxUses: f.get('uses'), days: f.get('days').toUpperCase().split(',').map(x => x.trim()).filter(Boolean) }), 'Đã thêm mã khuyến mãi', again); };
  box.querySelectorAll('[data-t]').forEach(b => b.onclick = () => act(() => API.togglePromo(b.dataset.t), 'Đã cập nhật mã', again));
}

async function aCombo(box) {
  const cs = await API.combos(), again = () => aCombo(box);
  box.innerHTML = `<h3>Thêm combo</h3><form id="f" ${FORM}>${fld('name', 'Tên combo', 'required')}${fld('desc', 'Mô tả', 'required')}${fld('price', 'Giá (đ)', 'type="number" min="0" step="1000" required')}<button class="btn">Thêm combo</button></form>
  <h3>Danh sách combo</h3><table><tr><th>Tên</th><th>Mô tả</th><th>Giá</th><th></th></tr>${cs.map(c => `<tr><td>${c.name}</td><td>${c.desc}</td><td>${money(c.price)}</td><td><button class="btn alt" data-d="${c.combo_id}">Xoá</button></td></tr>`).join('')}</table>`;
  $('#f').onsubmit = ev => { ev.preventDefault(); const f = new FormData(ev.target); act(() => API.saveCombo({ name: f.get('name'), desc: f.get('desc'), price: f.get('price') }), 'Đã thêm combo', again); };
  box.querySelectorAll('[data-d]').forEach(b => b.onclick = () => act(() => API.deleteCombo(b.dataset.d), 'Đã xoá combo', again));
}

async function aCust(box) {
  const cs = await API.customers(), again = () => aCust(box);
  box.innerHTML = `<h3>Khách hàng</h3><table><tr><th>Mã</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th></th></tr>${cs.map(c => `<tr><td>${c.customer_id}</td><td>${esc(c.full_name)}</td><td>${esc(c.email)}</td><td>${c.role === 'ADMIN' ? 'Quản trị viên' : 'Khách hàng'}</td><td>${c.customer_id !== user.id ? `<button class="btn alt sm" data-r="${c.customer_id}">${c.role === 'ADMIN' ? 'Thu hồi quyền quản trị' : 'Cấp quyền quản trị'}</button>` : ''}</td></tr>`).join('')}</table>`;
  box.querySelectorAll('[data-r]').forEach(b => b.onclick = () => { const c = cs.find(x => x.customer_id == b.dataset.r); act(() => API.setRole(c.customer_id, c.role === 'ADMIN' ? 'CUSTOMER' : 'ADMIN'), 'Đã cập nhật quyền', again); });
}

function pQuenMk() {
  app.innerHTML = `<div class="wrap"><h1 class="t">Quên mật khẩu</h1><form id="f1" class="box" style="max-width:480px"><label class="f">Email đã đăng ký<br><input name="e" type="email" required style="width:100%"></label><button class="btn">Gửi mã OTP</button></form>
  <form id="f2" class="box" style="max-width:480px;margin-top:1rem" hidden><p id="otp" class="muted small"></p><label class="f">Mã OTP<br><input name="o" required inputmode="numeric" style="width:100%"></label>${pwField('p', 'Mật khẩu mới')}<button class="btn">Đặt lại mật khẩu</button></form></div>`;
  let email = '';
  $('#f1').onsubmit = async ev => { ev.preventDefault(); email = new FormData(ev.target).get('e'); try { const r = await API.requestReset(email); $('#f2').hidden = false; $('#otp').textContent = r && r.otp ? 'Mã OTP (giả lập email, có hiệu lực 10 phút): ' + r.otp : 'Mã OTP đã được gửi tới email của bạn.'; } catch (e) { showErr(e); } };
  $('#f2').onsubmit = async ev => { ev.preventDefault(); const f = new FormData(ev.target); try { await API.resetPassword(email, f.get('o'), f.get('p')); toast('Đã đặt lại mật khẩu, hãy đăng nhập'); setTimeout(() => location.href = 'dang-nhap.html', 1200); } catch (e) { showErr(e); } };
}

function pQtDangNhap() {
  if (user?.role === 'ADMIN') { location.href = 'quan-tri.html'; return; }
  app.innerHTML = `<div class="wrap"><h1 class="t">Đăng nhập quản trị viên</h1><form id="f" class="box" style="max-width:480px;margin:auto"><label class="f">Email quản trị<br><input name="e" type="email" required></label>${pwField('p', 'Mật khẩu')}<button class="btn">Đăng nhập quản trị</button></form></div>`;
  $('#f').onsubmit = async ev => {
    ev.preventDefault(); const f = new FormData(ev.target);
    try { const r = await API.login(f.get('e'), f.get('p')); if (r.role !== 'ADMIN') { toast('Tài khoản này không có quyền quản trị', true); return; } localStorage.setItem('cinema_user', JSON.stringify({ id: r.customer_id, name: r.full_name, email: f.get('e'), role: 'ADMIN' })); location.href = qs.get('next') || 'quan-tri.html'; } catch (e) { showErr(e); }
  };
}

const pages = { home: pHome, phim: pPhim, chitiet: pChiTiet, datve: pDatVe, ve: pVe, thanhvien: pThanhVien, uudai: pUuDai, quantri: pQuanTri, dangnhap: pDangNhap, vecuatoi: pVeCuaToi, rap: pRap, tintuc: pTinTuc, quenmk: pQuenMk, hoso: pHoSo, qtdangnhap: pQtDangNhap };
layout();
Promise.resolve().then(pages[document.body.dataset.page]).then(() => bindEyes()).catch(e => app.innerHTML = '<div class="wrap err">' + e.message + '</div>');
</file>

