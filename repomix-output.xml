  mountMovies($('#mv'), ms, 'now');
  let i = 0;
  const show = k => { i = k; const m = feat[k], d = m.metadata || {}; $('#hero').style.setProperty('--h', (m.movie_id * 67) % 360); $('#h-t').textContent = m.title; $('#h-m').textContent = m.genre + ' · ' + m.duration_min + ' phút · ' + m.rating; $('#h-d').textContent = d.director ? 'Đạo diễn ' + d.director + (d.language ? ', ' + d.language : '') : ''; $('#h-b').href = $('#h-i').href = 'chi-tiet.html?id=' + m.movie_id; $('#h-p').innerHTML = poster(m); document.querySelectorAll('.dots i').forEach((x, j) => x.className = j === k ? 'on' : ''); };
  document.querySelectorAll('.dots i').forEach((x, j) => x.onclick = () => show(j));
  if (feat.length) { show(0); setInterval(() => show((i + 1) % feat.length), 5000); }
  $('#qm').onchange = async e => {
    const ss = e.target.value ? await API.showtimes(e.target.value) : [];
    $('#qs').innerHTML = '<option value="">2. Chọn suất chiếu</option>' + ss.map(s => `<option value="${s.showtime_id}">${fDate(s.start_time)} ${fTime(s.start_time)}, ${s.theater_name || ''}, ${s.room_name}</option>`).join('');
    $('#qs').disabled = !ss.length; $('#qgo').disabled = true;
  };
  $('#qs').onchange = e => $('#qgo').disabled = !e.target.value;
  on('#qgo', () => location.href = 'dat-ve.html?st=' + $('#qs').value);
}

